VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Checkout is fail-closed when these are absent. Never set them in production.
# Disposable local development only:
# VITE_CHECKOUT_EXECUTION_MODE=local
# VITE_CHECKOUT_DISPOSABLE_ENV_ACK=I_UNDERSTAND_NO_PRODUCTION_CHECKOUT
# Disposable staging additionally requires:
# VITE_DEPLOYMENT_ENVIRONMENT=staging
# VITE_CHECKOUT_ALLOWED_PROJECT_REF=your-disposable-staging-project-ref

# Do not place admin credentials in VITE_* variables; Vite exposes them to browsers.
