# Supabase Edge Function configuration. Copy to functions/.env for disposable
# local development only; the actual file is ignored by Git.
CHECKOUT_EXECUTION_MODE=local
CHECKOUT_DEPLOYMENT_ENVIRONMENT=local
CHECKOUT_DISPOSABLE_ENV_ACK=I_UNDERSTAND_NO_PRODUCTION_CHECKOUT
CHECKOUT_ALLOWED_ORIGINS=http://127.0.0.1:5173
CHECKOUT_RATE_LIMIT_PEPPER=replace-with-a-random-secret-of-at-least-16-characters
CHECKOUT_RATE_LIMIT_MAX=5
CHECKOUT_RATE_LIMIT_WINDOW_SECONDS=60

# SUPABASE_URL and server credentials are supplied by the local Edge runtime or
# hosted Supabase secret management. Never expose a secret key through VITE_*.
